{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moondog:import:apple-music-library:track-snapshot:1",
  "title": "Moondog Apple Music Library Track Snapshot v1",
  "type": "object",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "rating": {
      "type": "object",
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "computed": {
          "type": "boolean"
        }
      },
      "required": [
        "value"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "track_snapshot_id": {
      "$ref": "#/$defs/uuid"
    },
    "import_batch_id": {
      "$ref": "#/$defs/uuid"
    },
    "subject_id": {
      "$ref": "#/$defs/uuid"
    },
    "track_ref_id": {
      "$ref": "#/$defs/uuid"
    },
    "captured_at": {
      "$ref": "#/$defs/utc_timestamp"
    },
    "source_record_key_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot_kind": {
      "const": "aggregate_library_state"
    },
    "aggregate_state": {
      "type": "object",
      "properties": {
        "play_count": {
          "type": "integer",
          "minimum": 0
        },
        "last_played_at": {
          "$ref": "#/$defs/utc_timestamp"
        },
        "skip_count": {
          "type": "integer",
          "minimum": 0
        },
        "last_skipped_at": {
          "$ref": "#/$defs/utc_timestamp"
        },
        "rating": {
          "$ref": "#/$defs/rating"
        },
        "album_rating": {
          "$ref": "#/$defs/rating"
        },
        "loved": {
          "type": "boolean"
        },
        "favorited": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "library_state": {
      "type": "object",
      "properties": {
        "date_added": {
          "$ref": "#/$defs/utc_timestamp"
        },
        "date_modified": {
          "$ref": "#/$defs/utc_timestamp"
        },
        "apple_music": {
          "type": "boolean"
        },
        "purchased": {
          "type": "boolean"
        },
        "playlist_only": {
          "type": "boolean"
        },
        "compilation": {
          "type": "boolean"
        },
        "unplayed": {
          "type": "boolean"
        },
        "disabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "track_snapshot_id",
    "import_batch_id",
    "subject_id",
    "track_ref_id",
    "captured_at",
    "source_record_key_sha256",
    "snapshot_kind",
    "aggregate_state",
    "library_state"
  ],
  "additionalProperties": false
}
