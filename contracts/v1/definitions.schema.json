{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moondog:contract:definitions:1",
  "title": "Moondog Contract Definitions v1",
  "$defs": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "namespaced_key": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "extensions": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9][a-z0-9_-]*)+$"
      },
      "additionalProperties": true
    },
    "external_ref": {
      "type": "object",
      "properties": {
        "system": {
          "$ref": "#/$defs/non_empty_string"
        },
        "entity_type": {
          "$ref": "#/$defs/namespaced_key"
        },
        "external_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^[^?#]+$"
        }
      },
      "required": [
        "system",
        "entity_type",
        "external_id"
      ],
      "additionalProperties": false
    },
    "typed_record_ref": {
      "type": "object",
      "properties": {
        "record_type": {
          "enum": [
            "track_ref",
            "listening_event",
            "taste_event",
            "profile_evidence"
          ]
        },
        "record_id": {
          "$ref": "#/$defs/uuid"
        }
      },
      "required": [
        "record_type",
        "record_id"
      ],
      "additionalProperties": false
    },
    "entity_ref": {
      "type": "object",
      "properties": {
        "entity_type": {
          "enum": [
            "track",
            "artist",
            "release",
            "playlist",
            "genre",
            "scene",
            "era",
            "musical_attribute",
            "creative_artifact"
          ]
        },
        "entity_id": {
          "$ref": "#/$defs/uuid"
        },
        "entity_revision": {
          "type": "integer",
          "minimum": 1
        },
        "entity_key": {
          "$ref": "#/$defs/namespaced_key"
        },
        "label": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "required": [
        "entity_type"
      ],
      "anyOf": [
        {
          "required": [
            "entity_id"
          ]
        },
        {
          "required": [
            "entity_key"
          ]
        }
      ],
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "context_type": {
          "enum": [
            "album",
            "playlist",
            "artist",
            "search",
            "queue",
            "radio",
            "recommendation",
            "external",
            "unknown"
          ]
        },
        "entity_ref": {
          "$ref": "#/$defs/entity_ref"
        }
      },
      "required": [
        "context_type"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_kind": {
          "enum": [
            "user_input",
            "import",
            "tool",
            "derived",
            "system"
          ]
        },
        "captured_at": {
          "$ref": "#/$defs/utc_timestamp"
        },
        "external_ref": {
          "$ref": "#/$defs/external_ref"
        },
        "import_batch_id": {
          "$ref": "#/$defs/uuid"
        },
        "source_record_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/typed_record_ref"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "source_kind",
        "captured_at"
      ],
      "additionalProperties": false
    }
  }
}
