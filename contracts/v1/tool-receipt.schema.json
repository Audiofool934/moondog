                  "required": [
                    "consumed_at"
                  ]
                }
              },
              "required": [
                "confirmation"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "awaiting_confirmation",
              "requires_human"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "effects": {
            "type": "array",
            "maxItems": 0
          },
          "usage": {
            "type": "array",
            "maxItems": 0
          },
          "privacy_egress": {
            "type": "array",
            "maxItems": 0
          },
          "budget_reservation": {
            "type": "object",
            "properties": {
              "state": {
                "const": "none"
              }
            }
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "started_at"
              ]
            },
            {
              "required": [
                "executor_ref"
              ]
            },
            {
              "required": [
                "idempotency"
              ]
            },
            {
              "properties": {
                "confirmation": {
                  "type": "object",
                  "properties": {
                    "consumed_at": {
                      "$ref": "urn:moondog:contract:definitions:1#/$defs/utc_timestamp"
                    }
                  },
                  "required": [
                    "consumed_at"
                  ]
                }
              },
              "required": [
                "confirmation"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "denied"
          },
          "idempotency": {
            "type": "object"
          }
