    "recovery": {
      "type": "object",
      "properties": {
        "action": {
          "enum": [
            "none",
            "retry",
            "reconcile",
            "rollback",
            "request_confirmation",
            "human_handoff"
          ]
        },
        "safe_summary": {
          "$ref": "urn:moondog:contract:definitions:1#/$defs/non_empty_string"
        }
      },
      "required": [
        "action",
        "safe_summary"
      ],
      "additionalProperties": false
