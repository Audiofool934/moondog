                }
              }
            }
          },
          "usage": {
            "type": "array",
            "maxItems": 0
          },
          "privacy_egress": {
            "type": "array",
            "maxItems": 0
          },
          "budget_reservation": {
            "type": "object",
            "properties": {
              "state": {
                "const": "none"
              }
            }
          }
        },
        "not": {
          "required": [
            "executor_ref"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "accepted"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "effects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "status": {
                  "const": "planned"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "effects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "applied",
                    "rolled_back"
                  ]
                }
              }
            }
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "error"
              ]
            },
            {
              "properties": {
                "effects": {
                  "type": "array",
                  "contains": {
                    "type": "object",
                    "properties": {
                      "status": {
                        "const": "unknown"
                      }
                    },
                    "required": [
                      "status"
                    ]
                  }
                }
              },
              "required": [
                "effects"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "simulated",
              "accepted",
              "succeeded",
              "failed",
              "timed_out",
              "partial",
              "unknown",
              "cancelled"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "policy_decision": {
            "type": "object",
            "properties": {
              "decision": {
                "const": "allow"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "effects": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": {
                "effect_type": {
                  "enum": [
                    "write_local",
                    "write_external",
                    "send_message",
                    "spend",
                    "publish",
                    "delete"
                  ]
                },
                "status": {
                  "const": "applied"
                }
              },
              "required": [
                "effect_type",
                "status"
              ]
            }
          }
        },
        "required": [
          "effects"
        ]
      },
      "then": {
        "required": [
          "executor_ref",
          "idempotency"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "idempotency": {
            "type": "object",
            "properties": {
              "disposition": {
                "const": "replayed"
              }
            },
            "required": [
              "disposition"
            ]
          }
        },
        "required": [
          "idempotency"
        ]
      },
      "then": {
        "required": [
          "deduplicated_from_receipt_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unknown"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "recovery"
        ],
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "retryable": {
                "const": false
              }
            }
          },
          "recovery": {
            "type": "object",
            "properties": {
              "action": {
                "enum": [
                  "reconcile",
                  "human_handoff"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "simulated",
              "denied",
              "succeeded",
              "failed",
              "timed_out",
              "partial",
              "unknown",
              "cancelled",
              "requires_human"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "finished_at"
        ]
      }
    }
  ],
  "additionalProperties": false
}
