      "type": "object",
      "properties": {
        "decision": {
          "enum": [
            "allow",
            "deny",
            "require_confirmation",
            "escalate"
          ]
        },
        "policy_ref": {
          "$ref": "urn:moondog:contract:definitions:1#/$defs/policy_ref"
        },
        "capability_registry_version": {
          "$ref": "urn:moondog:contract:definitions:1#/$defs/non_empty_string"
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:moondog:contract:definitions:1#/$defs/namespaced_key"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "decision",
        "policy_ref",
        "capability_registry_version",
        "reason_codes"
      ],
      "additionalProperties": false
    },
    "confirmation": {
      "type": "object",
      "properties": {
        "grant_id": {
          "$ref": "urn:moondog:contract:definitions:1#/$defs/uuid"
        },
        "verified_at": {
          "$ref": "urn:moondog:contract:definitions:1#/$defs/utc_timestamp"
        },
        "consumed_at": {
          "$ref": "urn:moondog:contract:definitions:1#/$defs/utc_timestamp"
        },
        "scope_digest": {
          "$ref": "urn:moondog:contract:definitions:1#/$defs/sha256"
        }
      },
      "required": [
        "grant_id",
        "verified_at",
        "scope_digest"
