        }
      },
      "required": [
        "executor_id",
        "version"
      ],
      "additionalProperties": false
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "effect_type": {
            "$ref": "urn:moondog:contract:definitions:1#/$defs/effect_kind"
          },
          "resource_ref": {
            "$ref": "urn:moondog:contract:definitions:1#/$defs/entity_ref"
          },
