        "required": [
          "status",
          "idempotency"
        ]
      },
      "then": {
        "properties": {
          "idempotency": {
            "type": "object",
            "properties": {
              "disposition": {
                "const": "conflict"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "awaiting_confirmation"
          }
