        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "urn:moondog:contract:definitions:1#/$defs/artifact_ref"
      },
      "uniqueItems": true
    },
    "result_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "error": {
      "type": "object",
      "properties": {
        "category": {
          "enum": [
            "validation",
            "authorization",
            "policy",
            "timeout",
            "rate_limit",
            "external_service",
            "internal",
            "unknown"
          ]
