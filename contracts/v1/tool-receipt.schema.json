    "idempotency": {
      "type": "object",
      "properties": {
        "key_digest": {
          "$ref": "urn:moondog:contract:definitions:1#/$defs/sha256"
        },
        "semantic_digest": {
          "$ref": "urn:moondog:contract:definitions:1#/$defs/sha256"
        },
        "disposition": {
          "enum": [
            "new",
            "replayed",
            "conflict"
          ]
        }
      },
      "required": [
        "key_digest",
        "semantic_digest",
        "disposition"
      ],
      "additionalProperties": false
    },
    "executor_ref": {
      "type": "object",
      "properties": {
        "executor_id": {
          "$ref": "urn:moondog:contract:definitions:1#/$defs/namespaced_key"
        },
        "version": {
          "$ref": "urn:moondog:contract:definitions:1#/$defs/non_empty_string"
        },
        "external_refs": {
          "type": "array",
          "items": {
