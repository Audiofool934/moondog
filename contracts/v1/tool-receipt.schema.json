    "receipt_id",
    "invocation_id",
    "subject_id",
    "capability_id",
    "capability_version",
    "invocation_semantic_digest",
    "attempt",
    "status",
    "recorded_at",
    "policy_decision",
    "effects",
    "usage",
    "budget_reservation",
    "privacy_egress",
    "artifacts"
