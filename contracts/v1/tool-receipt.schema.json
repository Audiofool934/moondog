            "required": [
              "consumed_at"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "idempotency": {
            "type": "object",
            "properties": {
              "disposition": {
                "const": "conflict"
              }
            },
            "required": [
              "disposition"
            ]
          }
        },
        "required": [
          "idempotency"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "denied"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "simulated"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "effects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "status": {
