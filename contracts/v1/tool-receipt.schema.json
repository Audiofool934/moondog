{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moondog:contract:tool-receipt:1",
  "title": "Moondog ToolReceipt v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "urn:moondog:contract:definitions:1#/$defs/schema_version"
    },
    "receipt_id": {
      "$ref": "urn:moondog:contract:definitions:1#/$defs/uuid"
    },
    "invocation_id": {
      "$ref": "urn:moondog:contract:definitions:1#/$defs/uuid"
    },
    "subject_id": {
      "$ref": "urn:moondog:contract:definitions:1#/$defs/uuid"
    },
    "capability_id": {
      "$ref": "urn:moondog:contract:definitions:1#/$defs/namespaced_key"
    },
    "capability_version": {
      "type": "integer",
      "minimum": 1
    },
    "invocation_semantic_digest": {
      "$ref": "urn:moondog:contract:definitions:1#/$defs/sha256"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "simulated",
        "denied",
        "awaiting_confirmation",
        "accepted",
        "succeeded",
        "failed",
        "timed_out",
        "partial",
        "unknown",
        "cancelled",
        "requires_human"
      ]
    },
    "recorded_at": {
      "$ref": "urn:moondog:contract:definitions:1#/$defs/utc_timestamp"
    },
    "started_at": {
      "$ref": "urn:moondog:contract:definitions:1#/$defs/utc_timestamp"
    },
    "finished_at": {
      "$ref": "urn:moondog:contract:definitions:1#/$defs/utc_timestamp"
    },
