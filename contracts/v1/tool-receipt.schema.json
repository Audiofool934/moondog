          "$ref": "urn:moondog:contract:definitions:1#/$defs/utc_timestamp"
        },
        "reconciled_at": {
          "$ref": "urn:moondog:contract:definitions:1#/$defs/utc_timestamp"
        }
      },
      "required": [
        "state",
        "reserved",
        "actual",
        "recorded_at"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "none"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "reserved": {
                "type": "array",
                "maxItems": 0
              },
              "actual": {
                "type": "array",
                "maxItems": 0
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "reservation_id"
                  ]
                },
                {
                  "required": [
                    "reconciled_at"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "reservation_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "reconciled",
                  "released"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "reconciled_at"
            ]
          }
        }
      ],
      "additionalProperties": false
