        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "recovery"
        ],
        "properties": {
          "policy_decision": {
            "type": "object",
            "properties": {
              "decision": {
                "const": "require_confirmation"
              }
            }
          },
          "recovery": {
            "type": "object",
            "properties": {
              "action": {
                "const": "request_confirmation"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "requires_human"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "recovery"
        ],
        "properties": {
          "policy_decision": {
            "type": "object",
            "properties": {
              "decision": {
                "const": "escalate"
              }
            }
          },
          "recovery": {
            "type": "object",
            "properties": {
              "action": {
                "const": "human_handoff"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "accepted",
              "succeeded",
              "failed",
              "timed_out",
              "partial",
              "unknown"
            ]
          },
          "confirmation": {
            "type": "object"
          }
        },
        "required": [
          "status",
          "confirmation"
        ]
      },
      "then": {
        "properties": {
          "confirmation": {
            "type": "object",
            "properties": {
              "consumed_at": {
                "$ref": "urn:moondog:contract:definitions:1#/$defs/utc_timestamp"
