{
  "sourceLanguage": "en",
  "strings": {
    "A song isn't available in this Apple Music region.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有首歌在这个 Apple Music 地区不可用。"
          }
        }
      }
    },
    "Allow Apple Music": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许使用 Apple Music"
          }
        }
      }
    },
    "Allow Apple Music on this iPhone first.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在这台 iPhone 上允许使用 Apple Music。"
          }
        }
      }
    },
    "Apple Music": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music"
          }
        }
      }
    },
    "Apple Music is off for Moondog": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Moondog 无法使用 Apple Music"
          }
        }
      }
    },
    "Apple Music's catalog can't be reached from Moondog: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Moondog 连不上 Apple Music 曲库：%@"
          }
        }
      }
    },
    "Ask Moondog": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "和 Moondog 说点什么"
          }
        }
      }
    },
    "Back to the conversation": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到对话"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Checking the request line": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看看点歌单"
          }
        }
      }
    },
    "Checking…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查…"
          }
        }
      }
    },
    "Connect": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接"
          }
        }
      }
    },
    "Connected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接"
          }
        }
      }
    },
    "Enter the pairing link": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入配对链接"
          }
        }
      }
    },
    "Enter your Mac's Tailscale address (100.x.y.z) and the 32-character key the host shows.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入 Mac 的 Tailscale 地址（100.x.y.z）和主机显示的 32 位密钥。"
          }
        }
      }
    },
    "Finding the cue": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找切入点"
          }
        }
      }
    },
    "Finding the groove": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找找律动"
          }
        }
      }
    },
    "Forget this Mac": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "忘记这台 Mac"
          }
        }
      }
    },
    "Mac": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac"
          }
        }
      }
    },
    "Mac address": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 地址"
          }
        }
      }
    },
    "Mic check": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试麦中"
          }
        }
      }
    },
    "Moondog lives on your Mac": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Moondog 住在你的 Mac 上"
          }
        }
      }
    },
    "Moondog will talk to the Mac at %@ instead of %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Moondog 将改为连接 %@ 这台 Mac，不再连接 %@。"
          }
        }
      }
    },
    "Needs an Apple Music subscription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要 Apple Music 订阅"
          }
        }
      }
    },
    "Next song": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一首"
          }
        }
      }
    },
    "Not allowed yet": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未允许"
          }
        }
      }
    },
    "Nothing is playing.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在没有在播放。"
          }
        }
      }
    },
    "Nothing to play.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可以播放的歌。"
          }
        }
      }
    },
    "Off for Moondog": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Moondog 无权使用"
          }
        }
      }
    },
    "Open Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开设置"
          }
        }
      }
    },
    "Or type them": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "或者手动输入"
          }
        }
      }
    },
    "Pair": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对"
          }
        }
      }
    },
    "Pair again": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新配对"
          }
        }
      }
    },
    "Pair another way": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用其他方式配对"
          }
        }
      }
    },
    "Pair with this Mac?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与这台 Mac 配对？"
          }
        }
      }
    },
    "Pairing key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对密钥"
          }
        }
      }
    },
    "Pairing key not accepted": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对密钥未被接受"
          }
        }
      }
    },
    "Pause": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停"
          }
        }
      }
    },
    "Planning the segue": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "琢磨怎么接歌"
          }
        }
      }
    },
    "Play": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放"
          }
        }
      }
    },
    "Play something": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放点音乐"
          }
        }
      }
    },
    "Play something for right now": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放点适合现在听的"
          }
        }
      }
    },
    "Playing whole songs needs an Apple Music subscription.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放完整歌曲需要 Apple Music 订阅。"
          }
        }
      }
    },
    "Plays whole songs on this iPhone": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这台 iPhone 上播放完整歌曲"
          }
        }
      }
    },
    "Point the camera at the code on your Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把相机对准 Mac 上的二维码。"
          }
        }
      }
    },
    "Previous song": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一首"
          }
        }
      }
    },
    "Reading the room": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看看现场气氛"
          }
        }
      }
    },
    "Restricted on this iPhone": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPhone 上受限制"
          }
        }
      }
    },
    "Riding the faders": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调调推子"
          }
        }
      }
    },
    "Run this in Moondog's mobile folder there, then scan the code it shows.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在那里的 Moondog mobile 文件夹里运行这条命令，然后扫描它显示的二维码。"
          }
        }
      }
    },
    "Scan the code": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描二维码"
          }
        }
      }
    },
    "Send": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置"
          }
        }
      }
    },
    "Shows the song and what comes next": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示这首歌和接下来的歌"
          }
        }
      }
    },
    "Simulated in Simulator, without sound": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在模拟器中模拟播放，没有声音"
          }
        }
      }
    },
    "Stop": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止"
          }
        }
      }
    },
    "That code isn't a Moondog pairing code.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是 Moondog 的配对二维码。"
          }
        }
      }
    },
    "That isn't a Moondog pairing link.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是 Moondog 的配对链接。"
          }
        }
      }
    },
    "The record alone": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只留唱片"
          }
        }
      }
    },
    "Up next": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接下来"
          }
        }
      }
    },
    "Waiting for your Mac": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等你的 Mac"
          }
        }
      }
    },
    "Working the decks": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搓碟中"
          }
        }
      }
    },
    "Your Mac didn't accept this pairing key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Mac 没有接受这个配对密钥。"
          }
        }
      }
    },
    "`npm run --silent host -- --show-key` shows the key on your Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上运行 `npm run --silent host -- --show-key` 可以看到配对密钥。"
          }
        }
      }
    },
    "`npm run pair` also copies the link; with the same Apple ID on both, it is ready to paste here.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "`npm run pair` 也会拷贝配对链接；两台设备登录同一个 Apple ID 时，可以直接粘贴到这里。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
