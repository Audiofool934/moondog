{
  "expo": {
    "name": "Moondog",
    "slug": "moondog-iphone",
    "version": "0.1.0",
    "platforms": ["ios"],
    "orientation": "default",
    "icon": "../assets/brand/moondog-app-icon.png",
    "ios": {
      "bundleIdentifier": "ai.audiofool.moondog",
      "infoPlist": {
        "NSAppleMusicUsageDescription": "Moondog uses your Apple Music subscription to play songs you ask for on this iPhone.",
        "NSLocalNetworkUsageDescription": "Connect to the Mac running your personal Moondog listening room.",
        "UIBackgroundModes": ["audio"],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "100.64.0.0/10": { "NSExceptionAllowsInsecureHTTPLoads": true },
            "127.0.0.1": { "NSExceptionAllowsInsecureHTTPLoads": true }
          }
        }
      }
    }
  }
}
