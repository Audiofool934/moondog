{
  "name": "moondog-app",
  "private": true,
  "type": "module",
  "description": "Moondog for Mac: a native window on the same core as the moondog command.",
  "license": "Apache-2.0",
  "main": "main.mjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "pack": "node pack.mjs",
    "release": "node pack.mjs --sign",
    "simulated": "node build.mjs && MOONDOG_APP_SIMULATED=1 electron ."
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2"
  }
}
