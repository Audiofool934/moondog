{
  "name": "moondog-app",
  "private": true,
  "type": "module",
  "description": "Moondog desktop: a native window on the same core as the moondog command.",
  "license": "Apache-2.0",
  "main": "main.mjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "pack": "node pack.mjs",
    "pack:dir": "node pack.mjs --dir",
    "smoke": "node smoke.mjs",
    "release": "node pack.mjs --sign",
    "publish-app": "node publish.mjs",
    "simulated": "node build.mjs && electron . --simulated",
    "harness": "node build.mjs && electron harness.mjs"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  }
}
